{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nordhold.asperntallow.de/contracts/release-metadata.schema.json",
  "title": "Nordhold Wiki Release Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "buildDate", "commitSha"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "buildDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
