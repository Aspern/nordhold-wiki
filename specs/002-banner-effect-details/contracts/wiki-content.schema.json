{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nordhold.asperntallow.de/contracts/wiki-content.schema.json",
  "title": "Nordhold Wiki Content Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameBuildId", "towers", "banners", "eligibility"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "gameBuildId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tower" }
    },
    "banners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/banner" }
    },
    "eligibility": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/eligibility" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 500 },
        "de": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "requiredLocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 500 },
        "de": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "bannerEffectRestriction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "bannerEffectFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "suffix", "hideEqualValues", "restriction"],
      "properties": {
        "prefix": {
          "type": "string",
          "enum": ["none", "plus", "plus-or-minus"]
        },
        "suffix": {
          "type": "string",
          "enum": ["none", "percent", "seconds", "multiplier"]
        },
        "hideEqualValues": { "type": "boolean" },
        "restriction": { "$ref": "#/$defs/bannerEffectRestriction" }
      }
    },
    "bannerRarityValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "rare", "legendary"],
      "properties": {
        "common": { "type": "number" },
        "rare": { "type": "number" },
        "legendary": { "type": "number" }
      }
    },
    "bannerRarityEffectValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "label", "values", "format"],
      "properties": {
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "label": { "$ref": "#/$defs/requiredLocalizedText" },
        "values": { "$ref": "#/$defs/bannerRarityValues" },
        "format": { "$ref": "#/$defs/bannerEffectFormat" }
      }
    },
    "bannerFixedEffectValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "label", "value", "format"],
      "properties": {
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "label": { "$ref": "#/$defs/requiredLocalizedText" },
        "value": { "type": "number" },
        "format": { "$ref": "#/$defs/bannerEffectFormat" }
      }
    },
    "bannerEffectValue": {
      "oneOf": [
        { "$ref": "#/$defs/bannerRarityEffectValue" },
        { "$ref": "#/$defs/bannerFixedEffectValue" }
      ]
    },
    "imageVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "assetId",
        "path",
        "width",
        "height",
        "sha256",
        "authorship",
        "licenseReference",
        "alt"
      ],
      "properties": {
        "kind": { "const": "image" },
        "assetId": { "$ref": "#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^src/assets/entities/towers/[a-z0-9][a-z0-9._/-]*\\.png$"
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorship": {
          "const": "authorized"
        },
        "licenseReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "alt": { "$ref": "#/$defs/localizedText" }
      }
    },
    "cssVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "assetId", "seed", "motif", "authorship", "licenseReference", "alt"],
      "properties": {
        "kind": { "const": "css" },
        "assetId": { "$ref": "#/$defs/stableId" },
        "seed": { "type": "integer", "minimum": 1, "maximum": 999999 },
        "motif": {
          "type": "string",
          "enum": ["crest", "rune", "orbit", "burst", "weave", "blade", "crown", "vortex"]
        },
        "authorship": { "const": "original" },
        "licenseReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "alt": { "$ref": "#/$defs/localizedText" }
      }
    },
    "tower": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceKey",
        "sortOrder",
        "name",
        "effectSummary",
        "visual",
        "provenanceRef"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "name": { "$ref": "#/$defs/localizedText" },
        "effectSummary": { "$ref": "#/$defs/requiredLocalizedText" },
        "visual": { "$ref": "#/$defs/imageVisual" },
        "provenanceRef": { "$ref": "#/$defs/stableId" }
      }
    },
    "banner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceKey",
        "sortOrder",
        "classification",
        "name",
        "effectDescription",
        "effectValues",
        "visual",
        "provenanceRef"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "sourceKey": { "$ref": "#/$defs/sourceKey" },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "classification": {
          "type": "string",
          "enum": ["tower-specific", "generalist", "unique", "fusion"]
        },
        "towerAffinityId": { "$ref": "#/$defs/stableId" },
        "name": { "$ref": "#/$defs/localizedText" },
        "effectDescription": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "de"],
          "properties": {
            "en": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "de": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "effectValues": {
          "type": "array",
          "items": { "$ref": "#/$defs/bannerEffectValue" }
        },
        "visual": { "$ref": "#/$defs/cssVisual" },
        "provenanceRef": { "$ref": "#/$defs/stableId" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "tower-specific" } },
            "required": ["classification"]
          },
          "then": {
            "required": ["towerAffinityId"],
            "properties": {
              "effectValues": {
                "type": "array",
                "items": { "$ref": "#/$defs/bannerRarityEffectValue" }
              }
            }
          },
          "else": {
            "not": { "required": ["towerAffinityId"] },
            "properties": {
              "effectValues": {
                "type": "array",
                "items": { "$ref": "#/$defs/bannerFixedEffectValue" }
              }
            }
          }
        }
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["towerId", "bannerId", "provenanceRef"],
      "properties": {
        "towerId": { "$ref": "#/$defs/stableId" },
        "bannerId": { "$ref": "#/$defs/stableId" },
        "provenanceRef": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
